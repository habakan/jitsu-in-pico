+
+/* FPU の無い MCU 向け: fitness 評価中は係数が変わらないので固定小数点に変換しておく。
+ * c0,c1,c3,c4 は Q24、c2,c5 は Q16、c6,c7 は Q36、u,v は Q8。範囲外なら float に戻す */
+static struct {
+	int32_t a[6], p[2];
+	bool ok;
+} fx;
+
+static bool fx_fits(quirc_float_t v, quirc_float_t scale)
+{
+	return v * scale > (quirc_float_t)INT32_MIN && v * scale < (quirc_float_t)INT32_MAX;
 }
 
+static void fx_setup(const quirc_float_t *c)
+{
+	static const quirc_float_t s[8] = {16777216.0, 16777216.0, 65536.0,
+		16777216.0, 16777216.0, 65536.0, 68719476736.0, 68719476736.0};
+	int i;
+
+	fx.ok = true;
+	for (i = 0; i < 8; i++) {
+		if (!fx_fits(c[i], s[i])) {
+			fx.ok = false;
+			return;
+		}
+		if (i < 6)
+			fx.a[i] = (int32_t)(c[i] * s[i]);
+		else
+			fx.p[i - 6] = (int32_t)(c[i] * s[i]);
+	}
+}
+
+static int fx_div_round(int32_t n, int32_t d)
+{
+	return (n >= 0) == (d >= 0) ? (n + d / 2) / d : (n - d / 2) / d;
+}
+
+static void fx_map(int32_t u, int32_t v, struct quirc_point *ret)
+{
+	/* 分子は Q32、分母は Q44 で積算し、どちらも Q16 に落として 32bit 除算する */
+	int64_t nx = (int64_t)fx.a[0] * u + (int64_t)fx.a[1] * v + ((int64_t)fx.a[2] << 16);
+	int64_t ny = (int64_t)fx.a[3] * u + (int64_t)fx.a[4] * v + ((int64_t)fx.a[5] << 16);
+	int64_t den = (int64_t)fx.p[0] * u + (int64_t)fx.p[1] * v + ((int64_t)1 << 44);
+	int32_t d = (int32_t)(den >> 28);
+
+	ret->x = fx_div_round((int32_t)(nx >> 16), d);
+	ret->y = fx_div_round((int32_t)(ny >> 16), d);
+}
